{
  "description": "POST /api/v1/chat/completions without streaming (docs/openapi.yaml ChatCompletionRequest / ChatCompletionResponse), including retry and error envelopes.",
  "cases": [
    {
      "name": "create sends the OpenAI-compatible body and returns the server request id",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 0 }
      },
      "input": {
        "model": "auto",
        "messages": [{ "role": "user", "content": "Hello" }],
        "temperature": 0.2
      },
      "expectedRequests": [
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": {
            "authorization": "Bearer sk-contract-key",
            "accept": "application/json",
            "content-type": "application/json",
            "x-request-id": "req-contract-1"
          },
          "body": {
            "model": "auto",
            "messages": [{ "role": "user", "content": "Hello" }],
            "temperature": 0.2,
            "stream": false
          }
        }
      ],
      "responses": [
        {
          "status": 200,
          "headers": { "content-type": "application/json", "x-request-id": "srv-req-1" },
          "json": {
            "id": "chatcmpl-1",
            "object": "chat.completion",
            "created": 1767225600,
            "model": "auto",
            "choices": [
              {
                "index": 0,
                "message": { "role": "assistant", "content": "Hi there" },
                "finish_reason": "stop"
              }
            ],
            "usage": { "prompt_tokens": 3, "completion_tokens": 2, "total_tokens": 5 }
          }
        }
      ],
      "expected": {
        "result": {
          "status": 200,
          "requestId": "srv-req-1",
          "clientRequestId": "req-contract-1",
          "data": {
            "id": "chatcmpl-1",
            "object": "chat.completion",
            "created": 1767225600,
            "model": "auto",
            "choices": [
              {
                "index": 0,
                "message": { "role": "assistant", "content": "Hi there" },
                "finish_reason": "stop"
              }
            ],
            "usage": { "prompt_tokens": 3, "completion_tokens": 2, "total_tokens": 5 }
          }
        }
      }
    },
    {
      "name": "a 503 with Retry-After is retried with the same x-request-id",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 2, "baseDelayMs": 250, "maxDelayMs": 8000 }
      },
      "input": { "model": "auto", "messages": [{ "role": "user", "content": "Hello" }] },
      "expectedRequests": [
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" },
          "body": {
            "model": "auto",
            "messages": [{ "role": "user", "content": "Hello" }],
            "stream": false
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" },
          "body": {
            "model": "auto",
            "messages": [{ "role": "user", "content": "Hello" }],
            "stream": false
          }
        }
      ],
      "responses": [
        {
          "status": 503,
          "headers": {
            "content-type": "application/json",
            "retry-after": "0.25",
            "x-request-id": "srv-503"
          },
          "json": {
            "error": {
              "message": "All upstream providers failed",
              "type": "server_error",
              "code": "upstream_unavailable"
            }
          }
        },
        {
          "status": 200,
          "headers": { "content-type": "application/json", "x-request-id": "srv-200" },
          "json": { "id": "chatcmpl-2", "object": "chat.completion", "choices": [] }
        }
      ],
      "expectedDelaysMs": [250],
      "expected": {
        "result": {
          "status": 200,
          "requestId": "srv-200",
          "clientRequestId": "req-contract-1",
          "data": { "id": "chatcmpl-2", "object": "chat.completion", "choices": [] }
        }
      }
    },
    {
      "name": "a 400 is not retried and exposes code, type, reason and request id",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 2, "baseDelayMs": 0 }
      },
      "input": { "model": "auto", "messages": [] },
      "expectedRequests": [{ "method": "POST", "path": "/api/v1/chat/completions" }],
      "responses": [
        {
          "status": 400,
          "headers": { "content-type": "application/json", "x-request-id": "srv-400" },
          "json": {
            "error": {
              "message": "messages must not be empty",
              "type": "invalid_request_error",
              "code": "invalid_request",
              "reason": "missing_messages"
            }
          }
        }
      ],
      "expected": {
        "error": {
          "status": 400,
          "message": "messages must not be empty",
          "type": "invalid_request_error",
          "code": "invalid_request",
          "reason": "missing_messages",
          "requestId": "srv-400",
          "retryAfterMs": null
        }
      }
    },
    {
      "name": "429 honours Retry-After and reports it once retries are exhausted",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 1, "baseDelayMs": 0, "maxDelayMs": 8000 }
      },
      "input": { "model": "auto", "messages": [{ "role": "user", "content": "Hello" }] },
      "expectedRequests": [
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" }
        },
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" }
        }
      ],
      "responses": [
        {
          "status": 429,
          "headers": {
            "content-type": "application/json",
            "retry-after": "2",
            "x-request-id": "srv-429-a"
          },
          "json": { "error": { "message": "[openai] All accounts rate limited" } }
        },
        {
          "status": 429,
          "headers": {
            "content-type": "application/json",
            "retry-after": "2",
            "x-request-id": "srv-429-b"
          },
          "json": { "error": { "message": "[openai] All accounts rate limited" } }
        }
      ],
      "expectedDelaysMs": [2000],
      "expected": {
        "error": {
          "status": 429,
          "message": "[openai] All accounts rate limited",
          "type": null,
          "code": null,
          "requestId": "srv-429-b",
          "retryAfterMs": 2000
        }
      }
    },
    {
      "name": "a 503 without Retry-After is not retried because the POST may already have run",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 2, "baseDelayMs": 250 }
      },
      "input": { "model": "auto", "messages": [{ "role": "user", "content": "Hello" }] },
      "expectedRequests": [
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" }
        }
      ],
      "responses": [
        {
          "status": 503,
          "headers": { "content-type": "application/json", "x-request-id": "srv-503" },
          "json": {
            "error": {
              "message": "All upstream providers failed",
              "type": "server_error",
              "code": "upstream_unavailable"
            }
          }
        }
      ],
      "expectedDelaysMs": [],
      "expected": {
        "error": {
          "status": 503,
          "message": "All upstream providers failed",
          "code": "upstream_unavailable",
          "requestId": "srv-503",
          "retryAfterMs": null
        }
      }
    },
    {
      "name": "retryNonIdempotent opts a POST back into retrying a 503 without Retry-After",
      "operation": "chatCompletions",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 1, "baseDelayMs": 250, "retryNonIdempotent": true }
      },
      "input": { "model": "auto", "messages": [{ "role": "user", "content": "Hello" }] },
      "expectedRequests": [
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" }
        },
        {
          "method": "POST",
          "path": "/api/v1/chat/completions",
          "headers": { "x-request-id": "req-contract-1" }
        }
      ],
      "responses": [
        {
          "status": 503,
          "headers": { "content-type": "application/json", "x-request-id": "srv-503" },
          "json": { "error": { "message": "All upstream providers failed" } }
        },
        {
          "status": 200,
          "headers": { "content-type": "application/json", "x-request-id": "srv-200" },
          "json": { "id": "chatcmpl-3", "object": "chat.completion", "choices": [] }
        }
      ],
      "expectedDelaysMs": [250],
      "expected": {
        "result": {
          "status": 200,
          "requestId": "srv-200",
          "clientRequestId": "req-contract-1",
          "data": { "id": "chatcmpl-3", "object": "chat.completion", "choices": [] }
        }
      }
    }
  ]
}
