              },
              {
                "providerId": "anthropic",
                "modelId": "claude-haiku",
                "score": 0,
                "eligible": false,
                "reasons": [
                  "capability match",
                  "allocation permitted",
                  "provider healthy",
                  "circuit open",
                  "quota healthy"
