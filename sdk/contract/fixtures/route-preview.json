    {
      "name": "preview falls back to the API key and surfaces a plain-string validation error",
      "operation": "routePreview",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 0 }
      },
      "input": { "candidates": [] },
      "expectedRequests": [
