        "managementKey": "mgmt-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 0 }
      },
      "input": {
        "candidates": [
          {
            "providerId": "openai",
            "modelId": "gpt-4o-mini",
            "capabilityScore": 0.9,
            "allocation": "allow",
            "healthScore": 1,
