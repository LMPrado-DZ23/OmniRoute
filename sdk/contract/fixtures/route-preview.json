      "expected": {
        "result": {
          "status": 200,
          "requestId": "srv-preview-1",
          "clientRequestId": "req-contract-1",
          "data": {
            "request": { "candidateCount": 2 },
            "selected": "openai",
            "candidates": [
              {
                "providerId": "openai",
                "modelId": "gpt-4o-mini",
                "score": 0.9,
                "eligible": true,
                "reasons": [
