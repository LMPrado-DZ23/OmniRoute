{
  "description": "GET /api/v1/models (docs/openapi.yaml Model list).",
  "cases": [
    {
      "name": "list sends no body and falls back to the client request id",
      "operation": "listModels",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 0 }
      },
      "expectedRequests": [
        {
          "method": "GET",
          "path": "/api/v1/models",
          "headers": {
            "authorization": "Bearer sk-contract-key",
            "accept": "application/json",
            "x-request-id": "req-contract-1"
          },
          "absentHeaders": ["content-type"],
          "body": null
        }
      ],
      "responses": [
        {
          "status": 200,
          "headers": { "content-type": "application/json" },
          "json": {
            "object": "list",
            "data": [
              { "id": "auto", "object": "model", "owned_by": "omniroute" },
              { "id": "openai/gpt-4o-mini", "object": "model", "owned_by": "openai" }
            ]
          }
        }
      ],
      "expected": {
        "result": {
          "status": 200,
          "requestId": "req-contract-1",
          "clientRequestId": "req-contract-1",
          "data": {
            "object": "list",
            "data": [
              { "id": "auto", "object": "model", "owned_by": "omniroute" },
              { "id": "openai/gpt-4o-mini", "object": "model", "owned_by": "openai" }
            ]
          }
        }
      }
    },
    {
      "name": "a 502 on a GET is retried",
      "operation": "listModels",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 1, "baseDelayMs": 100 }
      },
      "expectedRequests": [
        { "method": "GET", "path": "/api/v1/models" },
        { "method": "GET", "path": "/api/v1/models" }
      ],
      "responses": [
        { "status": 502, "headers": { "content-type": "text/plain" }, "text": "Bad Gateway" },
        {
          "status": 200,
          "headers": { "content-type": "application/json", "x-request-id": "srv-models-2" },
          "json": { "object": "list", "data": [] }
        }
      ],
      "expectedDelaysMs": [100],
      "expected": {
        "result": {
          "status": 200,
          "requestId": "srv-models-2",
          "clientRequestId": "req-contract-1",
          "data": { "object": "list", "data": [] }
        }
      }
    },
    {
      "name": "a non-JSON error body keeps the HTTP status as the message",
      "operation": "listModels",
      "client": {
        "apiKey": "sk-contract-key",
        "requestId": "req-contract-1",
        "retry": { "maxRetries": 0 }
      },
      "expectedRequests": [{ "method": "GET", "path": "/api/v1/models" }],
      "responses": [
        { "status": 502, "headers": { "content-type": "text/plain" }, "text": "Bad Gateway" }
      ],
      "expected": {
        "error": {
          "status": 502,
          "message": "HTTP 502",
          "code": null,
          "type": null,
          "requestId": "req-contract-1"
        }
      }
    }
  ]
}
